{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.(?:pdf|png|jpg|jpeg|svg|ico|json|txt|xml|webp|woff2?|js|css)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/cv-patrik-de-oliveira.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"cv-patrik-de-oliveira.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    }
  ]
}
